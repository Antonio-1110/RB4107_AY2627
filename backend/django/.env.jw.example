# Copy to backend/django/.env. Environment variables override this file.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Singapore
# Set a private key for any deployment beyond the local bench.
DJANGO_SECRET_KEY=dev-only-change-this

RB4107_MQTT_HOST=localhost
RB4107_MQTT_PORT=1883
RB4107_MQTT_TOPIC=rb4107/#
RB4107_MQTT_USERNAME=
RB4107_MQTT_PASSWORD=
RB4107_MQTT_CLIENT_ID=rb4107-django-subscriber
RB4107_MQTT_PERSISTENT_SESSION=1

# Multiple controllers: assign each firmware prefix rb4107/<controller_id>,
# then subscribe here to rb4107/+/# to avoid retained-topic collisions.
RB4107_LOCATION_CATALOG_FILE=location_catalog.jw.json
RB4107_DEVICE_STALE_SECONDS=15
RB4107_WORKER_STALE_SECONDS=10
RB4107_DASHBOARD_POLL_MS=2000
# RB4107_SQLITE_PATH=/absolute/path/to/monitoring.sqlite3
