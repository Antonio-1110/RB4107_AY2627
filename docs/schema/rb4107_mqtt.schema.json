{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rb4107.local/schema/rb4107_mqtt.schema.json",
  "title": "RB4107 MQTT payloads, schema_version 2",
  "description": "Every message the ESP32-S3 controller publishes under rb4107/#. Produced by firmware/components/rb_json. Unknown extra fields are allowed so the schema can grow (e.g. more sensors).",
  "type": "object",
  "required": ["schema_version", "type"],
  "properties": {
    "schema_version": {"const": 2}
  },
  "oneOf": [
    {"$ref": "#/$defs/telemetry"},
    {"$ref": "#/$defs/heartbeat"},
    {"$ref": "#/$defs/faults"},
    {"$ref": "#/$defs/presence_msg"},
    {"$ref": "#/$defs/thermal_msg"},
    {"$ref": "#/$defs/thermal_frame_msg"},
    {"$ref": "#/$defs/node_status"},
    {"$ref": "#/$defs/event"},
    {"$ref": "#/$defs/controller_status"},
    {"$ref": "#/$defs/c4002_config"},
    {"$ref": "#/$defs/c4002_live"}
  ],
  "$defs": {
    "header": {
      "type": "object",
      "required": ["schema_version", "type", "controller_id", "timestamp", "uptime_ms", "sequence"],
      "properties": {
        "schema_version": {"const": 2},
        "type": {"type": "string"},
        "controller_id": {"type": "string", "minLength": 1},
        "boot_id": {"type": "string", "minLength": 1, "description": "random per controller boot; with sequence it orders messages across reboots (optional: firmware before 2026-09-30 does not send it)"},
        "timestamp": {"type": ["string", "null"], "description": "ISO 8601 with offset; null while the controller's wall clock is not set"},
        "uptime_ms": {"type": "integer", "minimum": 0},
        "sequence": {"type": "integer", "minimum": 0}
      }
    },
    "nullable_number": {"type": ["number", "null"]},
    "nullable_bool": {"type": ["boolean", "null"]},
    "safety_state": {"enum": ["BOOT", "SELF_TEST", "IDLE", "MONITORING", "UNATTENDED", "WARNING", "SHUTDOWN", "FAULT"]},
    "node_link": {"enum": ["NEVER_SEEN", "ONLINE", "STALE", "OFFLINE"]},
    "node_role": {"enum": ["presence", "thermal"]},
    "presence_state": {"enum": ["PRESENT", "ABSENT", "UNKNOWN"]},
    "node_summary": {
      "type": "object",
      "required": ["sensor_node", "role", "link", "valid", "detected"],
      "properties": {
        "sensor_node": {"type": "string"},
        "role": {"$ref": "#/$defs/node_role"},
        "link": {"$ref": "#/$defs/node_link"},
        "valid": {"type": "boolean"},
        "detected": {"$ref": "#/$defs/nullable_bool", "description": "presence nodes with a valid reading only; null otherwise"}
      },
      "if": {"properties": {"valid": {"const": false}}},
      "then": {"properties": {"detected": {"type": "null"}}}
    },
    "presence": {
      "type": "object",
      "required": ["valid", "detected", "moving", "stationary", "distance_m"],
      "properties": {
        "valid": {"type": "boolean"},
        "detected": {"$ref": "#/$defs/nullable_bool"},
        "moving": {"$ref": "#/$defs/nullable_bool"},
        "stationary": {"$ref": "#/$defs/nullable_bool"},
        "distance_m": {"$ref": "#/$defs/nullable_number"}
      },
      "if": {"properties": {"valid": {"const": false}}},
      "then": {"properties": {"detected": {"type": "null"}, "moving": {"type": "null"}, "stationary": {"type": "null"}}}
    },
    "thermal": {
      "type": "object",
      "required": ["valid", "max_c", "min_c", "mean_c", "hot_region_c", "rate_c_per_min", "pixels_above_threshold"],
      "properties": {
        "valid": {"type": "boolean"},
        "max_c": {"$ref": "#/$defs/nullable_number"},
        "min_c": {"$ref": "#/$defs/nullable_number"},
        "mean_c": {"$ref": "#/$defs/nullable_number"},
        "hot_region_c": {"$ref": "#/$defs/nullable_number"},
        "rate_c_per_min": {"$ref": "#/$defs/nullable_number"},
        "pixels_above_threshold": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "telemetry": {
      "allOf": [{"$ref": "#/$defs/header"}],
      "required": ["protocol_version", "presence_state", "nodes", "thermal", "safety", "faults"],
      "properties": {
        "type": {"const": "telemetry"},
        "protocol_version": {"type": "integer", "minimum": 0},
        "presence_state": {"$ref": "#/$defs/presence_state", "description": "both presence nodes combined, as the safety state machine used it"},
        "nodes": {"type": "array", "items": {"$ref": "#/$defs/node_summary"}},
        "thermal": {"$ref": "#/$defs/thermal", "description": "the thermal node's reading"},
        "safety": {
          "type": "object",
          "required": ["state", "state_ms", "unattended_ms", "buzzer", "shutdown", "test_timers"],
          "properties": {
            "state": {"$ref": "#/$defs/safety_state"},
            "state_ms": {"type": "integer", "minimum": 0},
            "unattended_ms": {"type": "integer", "minimum": 0},
            "buzzer": {"enum": ["OFF", "WARNING", "SHUTDOWN", "FAULT"]},
            "shutdown": {"type": "boolean"},
            "reset_required": {"type": "boolean", "description": "supply cut and latched until an operator reset"},
            "warning_after_ms": {"type": "integer", "minimum": 0, "description": "configured unattended time before WARNING"},
            "shutdown_after_ms": {"type": "integer", "minimum": 0, "description": "configured time before SHUTDOWN, counted from shutdown_counts_from"},
            "shutdown_counts_from": {"enum": ["UNATTENDED", "WARNING"]},
            "test_timers": {"type": "boolean"}
          }
        },
        "faults": {"type": "array", "items": {"type": "string"}}
      }
    },
    "heartbeat": {
      "allOf": [{"$ref": "#/$defs/header"}],
      "required": ["safety_state", "safety_loop_count"],
      "properties": {
        "type": {"const": "heartbeat"},
        "safety_state": {"$ref": "#/$defs/safety_state"},
        "safety_loop_count": {"type": "integer", "minimum": 0}
      }
    },
    "faults": {
      "allOf": [{"$ref": "#/$defs/header"}],
      "required": ["faults"],
      "properties": {
        "type": {"const": "faults"},
        "faults": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "class"],
            "properties": {"name": {"type": "string"}, "class": {"enum": ["SAFETY", "TELEMETRY"]}}
          }
        }
      }
    },
    "presence_msg": {
      "allOf": [{"$ref": "#/$defs/header"}],
      "required": ["sensor_node", "presence"],
      "properties": {"type": {"const": "presence"}, "sensor_node": {"type": "string"}, "presence": {"$ref": "#/$defs/presence"}}
    },
    "thermal_msg": {
      "allOf": [{"$ref": "#/$defs/header"}],
      "required": ["sensor_node", "thermal"],
      "properties": {"type": {"const": "thermal"}, "sensor_node": {"type": "string"}, "thermal": {"$ref": "#/$defs/thermal"}}
    },
    "thermal_frame_msg": {
      "description": "One MLX90640 heat-map picture (display only; the safety logic never uses it). Pixel value v is base_c + v * step_c degC; the value 'invalid' means no reading. Pixels are row by row, 'width' per row.",
      "allOf": [{"$ref": "#/$defs/header"}],
      "required": ["sensor_node", "frame"],
      "properties": {
        "type": {"const": "thermal_frame"},
        "sensor_node": {"type": "string"},
        "frame": {
          "type": "object",
          "required": ["number", "width", "height", "base_c", "step_c", "invalid", "encoding", "pixels"],
          "properties": {
            "number": {"type": "integer", "minimum": 0, "description": "the thermal node's picture counter; restarts when the node reboots"},
            "width": {"const": 32},
            "height": {"const": 24},
            "base_c": {"type": "number"},
            "step_c": {"type": "number", "exclusiveMinimum": 0},
            "invalid": {"type": "integer", "minimum": 0, "maximum": 255},
            "encoding": {"const": "u8_base64"},
            "pixels": {"type": "string", "minLength": 1024, "maxLength": 1024, "pattern": "^[A-Za-z0-9+/]*={0,2}$", "description": "width*height bytes, base64"}
          }
        }
      }
    },
    "node_status": {
      "allOf": [{"$ref": "#/$defs/header"}],
      "required": ["sensor_node", "role", "link", "valid", "node_fault_flags", "missed_packets", "restarts"],
      "properties": {
        "type": {"const": "node_status"},
        "sensor_node": {"type": "string"},
        "role": {"$ref": "#/$defs/node_role"},
        "link": {"$ref": "#/$defs/node_link"},
        "valid": {"type": "boolean"},
        "node_fault_flags": {"type": "integer", "minimum": 0},
        "missed_packets": {"type": "integer", "minimum": 0},
        "restarts": {"type": "integer", "minimum": 0}
      }
    },
    "event": {
      "allOf": [{"$ref": "#/$defs/header"}],
      "required": ["event", "safety", "fault"],
      "properties": {
        "type": {"const": "event"},
        "event": {"enum": ["state_change", "warning", "shutdown", "fault_raised", "fault_cleared"]},
        "safety": {
          "type": "object",
          "required": ["state", "from_state", "reason", "unattended_ms"],
          "properties": {
            "state": {"$ref": "#/$defs/safety_state"},
            "from_state": {"oneOf": [{"$ref": "#/$defs/safety_state"}, {"type": "null"}]},
            "reason": {"type": ["string", "null"]},
            "unattended_ms": {"type": "integer", "minimum": 0}
          }
        },
        "fault": {
          "oneOf": [
            {"type": "null"},
            {"type": "object", "required": ["name", "class"], "properties": {"name": {"type": "string"}, "class": {"enum": ["SAFETY", "TELEMETRY"]}}}
          ]
        }
      }
    },
    "controller_status": {
      "description": "Retained rb4107/controller/status payload (also the MQTT Last Will).",
      "type": "object",
      "required": ["schema_version", "type", "controller_id", "online"],
      "properties": {
        "type": {"const": "controller_status"},
        "controller_id": {"type": "string"},
        "boot_id": {"type": "string", "minLength": 1},
        "online": {"type": "boolean"}
      }
    },
    "c4002_sensitivity": {"enum": ["low", "mid", "high", "custom"]},
    "c4002_gates": {"type": "array", "minItems": 25, "maxItems": 25, "items": {"type": "integer", "minimum": 0, "maximum": 1}, "description": "one entry per distance gate, 1 = enabled; 80 cm resolution only uses the first 15"},
    "c4002_thresholds": {"type": "array", "minItems": 25, "maxItems": 25, "items": {"type": "integer", "minimum": 0, "maximum": 99}, "description": "one threshold per distance gate, used with sensitivity custom; 80 cm resolution only uses the first 15"},
    "c4002_settings": {
      "type": "object",
      "required": ["report_period_ds", "range_min_cm", "range_max_cm", "resolution_cm", "gate_count", "motion_sensitivity", "presence_sensitivity", "disappear_delay_s", "lock_time_ds", "motion_gates", "presence_gates", "motion_thresholds", "presence_thresholds"],
      "properties": {
        "report_period_ds": {"type": "integer", "minimum": 1, "maximum": 255},
        "range_min_cm": {"type": "integer", "minimum": 0, "maximum": 1100},
        "range_max_cm": {"type": "integer", "minimum": 0, "maximum": 1100},
        "resolution_cm": {"enum": [20, 80]},
        "gate_count": {"enum": [15, 25]},
        "motion_sensitivity": {"$ref": "#/$defs/c4002_sensitivity"},
        "presence_sensitivity": {"$ref": "#/$defs/c4002_sensitivity"},
        "disappear_delay_s": {"type": "integer", "minimum": 0, "maximum": 65535},
        "lock_time_ds": {"type": "integer", "minimum": 2, "maximum": 100},
        "motion_gates": {"$ref": "#/$defs/c4002_gates"},
        "presence_gates": {"$ref": "#/$defs/c4002_gates"},
        "motion_thresholds": {"oneOf": [{"$ref": "#/$defs/c4002_thresholds"}, {"type": "null"}]},
        "presence_thresholds": {"oneOf": [{"$ref": "#/$defs/c4002_thresholds"}, {"type": "null"}]}
      }
    },
    "c4002_config": {
      "description": "Retained rb4107/sensors/<node>/c4002_config: the presence node's C4002 settings, or what happened to the last tuning command (docs/c4002_tuning.md).",
      "allOf": [{"$ref": "#/$defs/header"}],
      "required": ["sensor_node", "request_id", "action", "result", "error", "calibration_remaining_s", "saved", "settings"],
      "properties": {
        "type": {"const": "c4002_config"},
        "sensor_node": {"type": "string"},
        "request_id": {"type": "integer", "minimum": 0, "maximum": 65535, "description": "of the command answered; 0 = the controller asked on its own"},
        "action": {"oneOf": [{"enum": ["apply", "calibrate", "read", "reset"]}, {"type": "null"}]},
        "result": {"enum": ["ok", "invalid", "sensor_error", "rejected", "unknown_node", "send_failed", "no_reply"]},
        "error": {"type": ["string", "null"]},
        "calibration_remaining_s": {"type": "integer", "minimum": 0},
        "saved": {"type": ["boolean", "null"]},
        "settings": {"oneOf": [{"$ref": "#/$defs/c4002_settings"}, {"type": "null"}]}
      }
    },
    "c4002_live": {
      "description": "rb4107/sensors/<node>/c4002_live (QoS 0, not retained): one raw C4002 result as the sensor reported it, a few per second, for the dashboard's live radar view (docs/c4002_tuning.md). Not used by the safety logic.",
      "allOf": [{"$ref": "#/$defs/header"}],
      "required": ["sensor_node", "node_uptime_ms", "results", "age_ms", "target", "gate_size_cm", "presence_gates", "presence", "motion", "light_lux", "calibration_remaining_s"],
      "properties": {
        "type": {"const": "c4002_live"},
        "sensor_node": {"type": "string"},
        "node_uptime_ms": {"type": "integer", "minimum": 0},
        "results": {"type": "integer", "minimum": 0, "description": "results the node received from the sensor since boot; gaps mean skipped results"},
        "age_ms": {"type": "integer", "minimum": 0, "maximum": 65535},
        "target": {"oneOf": [{"enum": ["none", "stationary", "moving"]}, {"type": "null"}], "description": "the sensor's own verdict; null = unknown code"},
        "gate_size_cm": {"enum": [20, 80]},
        "presence_gates": {"type": "array", "maxItems": 25, "items": {"type": "integer", "minimum": 0, "maximum": 24}, "description": "indices of the gates holding a stationary target; gate i covers i*gate_size_cm to (i+1)*gate_size_cm"},
        "presence": {
          "type": "object", "additionalProperties": false, "required": ["distance_cm", "energy", "countdown_s"],
          "properties": {
            "distance_cm": {"type": "integer", "minimum": 0},
            "energy": {"type": "integer", "minimum": 0, "maximum": 255},
            "countdown_s": {"type": "integer", "minimum": 0}
          }
        },
        "motion": {
          "type": "object", "additionalProperties": false, "required": ["distance_cm", "speed_cm_s", "energy", "direction"],
          "properties": {
            "distance_cm": {"type": "integer", "minimum": 0},
            "speed_cm_s": {"type": "integer"},
            "energy": {"type": "integer", "minimum": 0, "maximum": 255},
            "direction": {"oneOf": [{"enum": ["away", "none", "approaching"]}, {"type": "null"}]}
          }
        },
        "light_lux": {"type": ["number", "null"], "minimum": 0},
        "calibration_remaining_s": {"type": "integer", "minimum": 0}
      }
    },
    "c4002_command": {
      "description": "Dashboard -> controller on rb4107/sensors/<node>/c4002_set (published by Django, not retained). Settings keys are only allowed with action apply; any subset may be sent.",
      "type": "object",
      "required": ["schema_version", "type", "request_id", "action"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": 2},
        "type": {"const": "c4002_command"},
        "controller_id": {"type": "string", "minLength": 1},
        "request_id": {"type": "integer", "minimum": 1, "maximum": 65535},
        "action": {"enum": ["apply", "calibrate", "read", "reset"]},
        "calibration_delay_s": {"type": "integer", "minimum": 0, "maximum": 600},
        "calibration_duration_s": {"type": "integer", "minimum": 1, "maximum": 600},
        "report_period_ds": {"type": "integer", "minimum": 1, "maximum": 255},
        "range_min_cm": {"type": "integer", "minimum": 0, "maximum": 1100},
        "range_max_cm": {"type": "integer", "minimum": 0, "maximum": 1100},
        "resolution_cm": {"enum": [20, 80]},
        "motion_sensitivity": {"$ref": "#/$defs/c4002_sensitivity"},
        "presence_sensitivity": {"$ref": "#/$defs/c4002_sensitivity"},
        "disappear_delay_s": {"type": "integer", "minimum": 0, "maximum": 65535},
        "lock_time_ds": {"type": "integer", "minimum": 2, "maximum": 100},
        "motion_gates": {"$ref": "#/$defs/c4002_gates"},
        "presence_gates": {"$ref": "#/$defs/c4002_gates"},
        "motion_thresholds": {"$ref": "#/$defs/c4002_thresholds"},
        "presence_thresholds": {"$ref": "#/$defs/c4002_thresholds"}
      }
    }
  }
}
