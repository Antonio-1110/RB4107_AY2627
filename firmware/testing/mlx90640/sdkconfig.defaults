CONFIG_IDF_TARGET="esp32c6"
# DFR1117 ESP32-C6 mini: USB-C goes to the native USB-Serial/JTAG, which keeps
# UART0/UART1 pins free for the C4002.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# MLX90640_ExtractParameters() keeps a 3 KB table on the stack (vendor code),
# and this test calls it from app_main.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
