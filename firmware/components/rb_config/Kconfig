        menu "Shutdown relay"

            config RB_SHUTDOWN_RELAY_CHANNEL
                int "Relay channel used for shutdown (1-8)"
                range 1 8
                default 1

            config RB_RELAY_ACTIVE_LEVEL
                int "TCA9554 output level that energises a relay"
                range 0 1
                default 0
                help
                    0 on the Waveshare 8DI-8DO: a low TCA9554 pin switches the
                    digital output on (confirmed on the bench). The earlier
                    relay prototype used 1.

            choice RB_SHUTDOWN_POLARITY
                prompt "Relay polarity"
                default RB_SHUTDOWN_DEENERGISE_TO_SHUT_DOWN
                help
                    The digital output stays on (relay energised, appliance
                    circuit closed) while it is safe, and turns off on
                    shutdown. A controller with no power also breaks the
                    circuit.
                config RB_SHUTDOWN_ENERGISE_TO_SHUT_DOWN
                    bool "energise relay to shut down (appliance on NC contact)"
                config RB_SHUTDOWN_DEENERGISE_TO_SHUT_DOWN
                    bool "de-energise relay to shut down (appliance on NO contact, fail-safe)"
            endchoice

            choice RB_SHUTDOWN_BOOT_STATE
                prompt "Shutdown output at boot"
                default RB_SHUTDOWN_BOOT_RELEASED
                help
                    OPEN QUESTION: safe relay state during boot.
                config RB_SHUTDOWN_BOOT_RELEASED
                    bool "released (appliance powered)"
                config RB_SHUTDOWN_BOOT_ACTIVE
                    bool "active (appliance off until the controller is running)"
            endchoice

            config RB_SHUTDOWN_VERIFY_PERIOD_MS
                int "Read back and verify the relay output every (ms)"
                range 100 60000
                default 1000

        endmenu

        menu "Gas valve node"

            config RB_SHUTDOWN_VALVE_CHANNEL
                int "Wired valve line: output channel (0 = not used)"
                range 0 8
                default 0
                help
                    Wired valve node. This output is ON (terminal pulled to
                    GND) only while it is safe to keep the gas valve open. It
                    is OFF on shutdown, at boot until the controller runs, and
                    whenever the controller has no power, so the valve node
                    closes the valve. Wire the terminal to the valve node's
                    input GPIO and join the grounds. It follows the shutdown
                    output and ignores the relay polarity setting. Must differ
                    from the shutdown relay channel. 2 for the demo.

            config RB_CTRL_VALVE_WIRELESS
                bool "Wireless valve node (ESP-NOW keep-open heartbeat)"
                default n
                help
                    Sends VALVE_COMMAND to the valve node: KEEP_OPEN every
                    RB_CTRL_VALVE_KEEPALIVE_MS while safe, CLOSE on shutdown.
                    If the safety task stops running, the keep-opens stop and
                    the valve node closes on its own timeout.

            comment "Wireless valve node settings (used only when the option above is on)"

            config RB_CTRL_VALVE_NODE_MAC
                string "Valve node Wi-Fi STA MAC address"
                default "FF:FF:FF:FF:FF:FF"
                help
                    Copy the MAC the valve node prints at boot. Broadcast
                    works on the bench, but gets no delivery acknowledgement.

            config RB_CTRL_VALVE_NODE_ID
                int "Valve node ID"
                range 1 65535
                default 4
                help
                    RB_NODE_ID of the valve node. Commands carry it, and the
                    valve node ignores commands for another ID.

            config RB_CTRL_VALVE_KEEPALIVE_MS
                int "Keep-open / command period (ms)"
                range 100 5000
                default 1000
                help
                    Keep it well under the valve node's
                    RB_VALVE_LINK_TIMEOUT_MS (3 s).

            config RB_CTRL_VALVE_STATUS_TIMEOUT_MS
                int "Warn when no VALVE_STATUS arrives for (ms)"
                range 500 60000
                default 3000

        endmenu

