            config RB_CTRL_THERMAL_NODE_ID
                int "Thermal node ID"
                range 1 65535
                default 3
                help
                    RB_NODE_ID of the thermal node (firmware/thermal_node). Packets from
                    any node ID not listed here are counted and dropped.

            config RB_CTRL_C4002_REMOTE_TUNING
                bool "Relay C4002 tuning commands from the dashboard to the presence nodes"
                default y
                help
                    Subscribes to <prefix>/sensors/+/c4002_set and forwards
                    each command over ESP-NOW; the node's answer is published
                    on <prefix>/sensors/<node>/c4002_config. Never touches the
                    safety state machine (docs/c4002_tuning.md).

            config RB_CTRL_REMOTE_RESET
                bool "Accept the operator reset from the dashboard"
                default y
                help
                    Subscribes to <prefix>/controller/command. A "reset"
                    command does the same as the diagnostic console's `reset`:
                    it releases a latched SHUTDOWN (back to IDLE) and
                    acknowledges a WARNING when that needs an acknowledgement.
                    The broker has no login in the lab setup, so anyone on the
                    network can send it: turn this off outside the demo
                    (docs/remote_reset.md).

            config RB_CTRL_RX_QUEUE_LEN
                int "ESP-NOW receive queue length"
                range 4 64
                default 16
                help
                    A full queue drops packets and counts them as a queue
                    overflow fault.

            config RB_CTRL_NODE_STALE_MS
                int "Node STALE after (ms) without a packet"
                range 200 60000
                default 2000
                help
                    Make this a few node data periods long. While STALE the
                    node's readings count as UNKNOWN, not as "safe".

            config RB_CTRL_NODE_OFFLINE_MS
                int "Node OFFLINE after (ms) without a packet"
                range 500 600000
                default 10000

            config RB_CTRL_NODE_RESTART_LIMIT
                int "Raise node_restarting after this many node reboots (0 = off)"
                range 0 8
                default 3
                help
                    A node whose uptime jumps backwards has rebooted. This many
                    reboots within the window below raises the node_restarting
                    telemetry fault: unstable power, a crash loop, or someone
                    replaying the node's packets.

            config RB_CTRL_NODE_RESTART_WINDOW_S
                int "... within this many seconds"
                range 10 86400
                default 600

        endmenu

