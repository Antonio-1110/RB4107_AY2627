    menu "Network (ESP32-S3)"

        choice RB_NET_TYPE
            prompt "Controller network interface"
            default RB_NET_ETHERNET_WIFI
            help
                Only telemetry uses the network; safety never waits for it.
            config RB_NET_ETHERNET_WIFI
                bool "Ethernet, Wi-Fi when Ethernet is down"
                help
                    Ethernet is used whenever it has an IP address. After
                    RB_NET_FALLBACK_S without one (cable out, no DHCP, W5500
                    not responding) the controller joins the Wi-Fi network,
                    and leaves it again as soon as Ethernet is back. MQTT
                    reconnects over the new interface each time. With no
                    RB_WIFI_SSID set this is the same as Ethernet only.
            config RB_NET_ETHERNET
                bool "Ethernet (on-board W5500)"
            config RB_NET_WIFI
                bool "Wi-Fi station"
            config RB_NET_NONE
                bool "none (local safety only)"
            config RB_NET_QEMU_OPENETH
                bool "QEMU emulated Ethernet (testing only, never on hardware)"
                select ETH_USE_OPENETH
                help
                    Lets the controller firmware run in QEMU (idf.py qemu with
                    -nic user,model=open_eth) and reach a broker on the host
                    machine: MQTT/Django tests without hardware.
        endchoice

        config RB_NET_USES_ETHERNET
            bool
            default y if RB_NET_ETHERNET || RB_NET_ETHERNET_WIFI

        config RB_NET_USES_WIFI
            bool
            default y if RB_NET_WIFI || RB_NET_ETHERNET_WIFI

        config RB_NET_FALLBACK_S
            int "Switch to Wi-Fi after Ethernet has had no IP address for (s)"
            depends on RB_NET_ETHERNET_WIFI
            range 1 300
            default 5
            help
                Counted from boot and from every Ethernet link loss. Link
                drops shorter than this never touch Wi-Fi.

        menu "W5500 Ethernet"
            depends on RB_NET_USES_ETHERNET

            comment "Pins from the earlier prototype controller"

            config RB_ETH_SPI_HOST
                int "SPI host (1 = SPI2, 2 = SPI3)"
                range 1 2
                default 1

            config RB_ETH_SPI_MHZ
                int "SPI clock (MHz)"
                range 5 40
                default 20

            config RB_ETH_MOSI_GPIO
                int "MOSI GPIO"
                default 13

            config RB_ETH_MISO_GPIO
                int "MISO GPIO"
                default 14

            config RB_ETH_SCLK_GPIO
                int "SCLK GPIO"
                default 15

            config RB_ETH_CS_GPIO
                int "CS GPIO"
                default 16

            config RB_ETH_INT_GPIO
                int "INT GPIO (-1 = poll)"
                range -1 48
                default 12

            config RB_ETH_POLL_MS
                int "Poll period when INT is not used (ms)"
                range 1 1000
                default 10

            config RB_ETH_RST_GPIO
                int "PHY reset GPIO (-1 = not connected)"
                range -1 48
                default -1

        endmenu

        menu "Wi-Fi station"
            depends on RB_NET_USES_WIFI

            config RB_WIFI_SSID
                string "SSID"
                default ""

            config RB_WIFI_PASSWORD
                string "Password"
                default ""
                help
                    Stored in sdkconfig, which is git-ignored. Never commit it.

            config RB_WIFI_MAX_BACKOFF_MS
                int "Longest reconnect back-off (ms)"
                range 1000 300000
                default 30000

        endmenu

    endmenu

    menu "MQTT broker (MacBook)"

        config RB_BROKER_HOST
            string "Broker host (MacBook LAN IP or hostname)"
            default ""
            help
                The MacBook running Mosquitto. See tools/mqtt/README.md for how
                to find its LAN IP. A <name>.local hostname also works
                (resolved over mDNS) and stays the same when the router gives
                the MacBook another IP. Set it here rather than in code.

        config RB_BROKER_FALLBACK_HOST
            string "Fallback broker host (empty = none)"
            default ""
            help
                Tried in turn with RB_BROKER_HOST: after each failed
                connection attempt the controller switches to the other one.
                For example the MacBook's .local name as the host and its
                usual LAN IP here.

        config RB_BROKER_PORT
            int "Broker port"
            range 1 65535
            default 1883

        config RB_MQTT_CONTROLLER_ID
            string "Controller ID (MQTT client ID and JSON controller_id)"
            default "controller_01"

        config RB_MQTT_TOPIC_PREFIX
            string "Topic prefix"
            default "rb4107"

        config RB_MQTT_KEEPALIVE_S
            int "Keep-alive (s)"
            range 5 600
            default 15
            help
                Also sets how quickly the broker publishes the Last Will
                ("offline") if the controller disappears (about 1.5x this).

        config RB_MQTT_RECONNECT_MS
            int "Reconnect interval (ms)"
            range 1000 120000
            default 5000

        config RB_MQTT_OUTBOX_LIMIT_KB
            int "Outbox limit while disconnected (KB)"
            range 4 256
            default 32
            help
                QoS 1 events are kept up to this size while the broker is
                unreachable. QoS 0 telemetry is simply dropped while
                disconnected.

        config RB_MQTT_TELEMETRY_PERIOD_MS
            int "Periodic telemetry interval (ms)"
            range 200 60000
            default 1000
            help
                Routine telemetry (QoS 0). State changes, warnings, shutdowns
                and faults are published as soon as they happen, whatever this
                is set to.

        config RB_MQTT_PUBLISH_SENSOR_TOPICS
            bool "Also publish per-node presence/thermal topics every period"
            default y

        config RB_MQTT_PUBLISH_HEATMAP
            bool "Publish the thermal node's heat-map pictures"
            default y
            help
                Forwards each complete THERMAL_FRAME picture from the thermal
                node on sensors/<node>/thermal_frame (QoS 0, not retained),
                about 1.4 KB per picture. Display only.

    endmenu

    menu "Diagnostics / simulation"

        config RB_SIM_NODE
            bool "Simulated sensor nodes instead of ESP-NOW"
            default n
            help
                Feeds simulated packets from all configured sensor nodes (two
                presence, one thermal) into the controller in place of the
                real C6 boards (diagnostic mode, QEMU tests). The safety logic
                is exactly the same; only the source of the packets changes.

        config RB_OUTPUTS_SIMULATED
            bool "Simulated outputs (log only, don't drive the buzzer/relay)"
            default n
            help
                For bench or QEMU runs without the relay board. Never enable
                this on the installed system.

        config RB_DIAG_CONSOLE
            bool "Diagnostic console (esp_console REPL on the serial port)"
            default n

        config RB_DIAG_CONTINUITY_MONITOR
            bool "Critical-failure continuity monitor"
            default n
            help
                While MQTT is down, log every 5 s that the safety loop is
                alive (state, node link, buzzer, relay), and print a PASS/FAIL
                verdict when it reconnects (TODO section 30). Runs at
                priority 1, below everything it measures.

        config RB_DIAG_TEST_TIMERS_AT_BOOT
            bool "Start with accelerated test timers"
            default n

        config RB_DIAG_TEST_WARNING_S
            int "Test mode: unattended time before WARNING (s)"
            range 1 600
            default 5

        config RB_DIAG_TEST_SHUTDOWN_S
            int "Test mode: shutdown timeout (s)"
            range 2 600
            default 10

        config RB_DIAG_TEST_FAULT_SHUTDOWN_S
            int "Test mode: shut down after this long in FAULT (s, 0 = never)"
            range 0 600
            default 10

    endmenu

    menu "Safety logic (ESP32-S3)"

        comment "Defaults answer the open questions provisionally; see docs/safety_state_machine.md"

        config RB_SAFETY_SELF_TEST_TIMEOUT_MS
            int "Self-test timeout (ms)"
            range 1000 120000
            default 10000

        config RB_SAFETY_HEAT_ON_DC
            int "Cooking detected at hot-region temperature (0.1 degC)"
            range 0 3000
            default 500
            help
                IDLE -> MONITORING threshold. UNVERIFIED placeholder (50.0 degC):
                set it from collected thermal data.

        config RB_SAFETY_HEAT_OFF_DC
            int "Cooking over below hot-region temperature (0.1 degC)"
            range 0 3000
            default 400
            help
                Hysteresis. Must not be above the "cooking detected" value.
                UNVERIFIED placeholder.

        config RB_SAFETY_HEAT_ON_RATE_DC_PER_MIN
            int "Also detect cooking when rising at least (0.1 degC/min), 0 = off"
            range 0 10000
            default 0
            help
                Temperature-rate threshold. When non-zero, a hot region that
                is above the "cooking over" temperature and rising at least
                this fast also counts as cooking. Off by default: set it only
                once thermal data has been collected (UNVERIFIED).

        config RB_SAFETY_ABSENCE_DEBOUNCE_MS
            int "Absence must last (ms) before UNATTENDED"
            range 0 60000
            default 2000

        config RB_SAFETY_PRESENCE_RETURN_DEBOUNCE_MS
            int "Presence must last (ms) to cancel UNATTENDED/WARNING"
            range 0 60000
            default 0
            help
                Raise this if spurious static detections by the C4002 cancel
                the unattended timer.

        config RB_SAFETY_WARNING_TIMEOUT_S
            int "Unattended time before WARNING (s)"
            range 1 3600
            default 60

        config RB_SAFETY_SHUTDOWN_TIMEOUT_S
            int "Shutdown timeout (s)"
            range 1 3600
            default 90
            help
                Meaning depends on "Shutdown timeout counts from" below.

        choice RB_SAFETY_SHUTDOWN_TIMING
            prompt "Shutdown timeout counts from"
            default RB_SAFETY_SHUTDOWN_FROM_UNATTENDED
            help
                OPEN QUESTION: is 90 s total unattended time or 90 s after the warning?
            config RB_SAFETY_SHUTDOWN_FROM_UNATTENDED
                bool "start of UNATTENDED (total unattended time)"
            config RB_SAFETY_SHUTDOWN_FROM_WARNING
                bool "start of WARNING"
        endchoice

        choice RB_SAFETY_WARNING_EXIT
            prompt "Person returns during WARNING"
            default RB_SAFETY_WARNING_EXIT_PRESENCE
            help
                OPEN QUESTION.
            config RB_SAFETY_WARNING_EXIT_PRESENCE
                bool "return to MONITORING"
            config RB_SAFETY_WARNING_EXIT_ACK
                bool "stay in WARNING until the person acknowledges (reset input)"
        endchoice

        choice RB_SAFETY_COOLING
            prompt "Temperature falls while UNATTENDED/WARNING"
            default RB_SAFETY_COOLING_KEEP_TIMERS
            help
                OPEN QUESTION.
            config RB_SAFETY_COOLING_KEEP_TIMERS
                bool "keep the timers running"
            config RB_SAFETY_COOLING_RETURN_TO_IDLE
                bool "return to IDLE and cancel the timers"
        endchoice

        config RB_SAFETY_FAULT_SHUTDOWN_S
            int "Shut down after this long in FAULT (s, 0 = never)"
            range 0 3600
            default 90
            help
                OPEN QUESTION: what to do when a safety-critical sensor fails.

    endmenu

endmenu
