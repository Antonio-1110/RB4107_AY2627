menu "RB4107 configuration"

    comment "Values marked UNCONFIRMED have not been verified on real hardware."

    menu "Logging"

        config RB_LOG_DEBUG_TAGS
            string "Tags to raise to DEBUG at boot (comma separated)"
            default ""
            help
                e.g. "ESPNOW,SAFETY". Needs "Component config -> Log ->
                Maximum log verbosity" set to Debug (sdkconfig option
                CONFIG_LOG_MAXIMUM_LEVEL_DEBUG); otherwise DEBUG lines are
                compiled out.

        config RB_LOG_QUIET_TAGS
            string "Tags to lower to WARN at boot (comma separated)"
            default ""
            help
                e.g. "TELEMETRY,NET" to keep the console focused on safety.

    endmenu

    menu "ESP-NOW link (shared by node and controller)"

        config RB_ESPNOW_CHANNEL
            int "Wi-Fi channel used for ESP-NOW"
            range 1 13
            default 1
            help
                The channel the controller and every node start on. With the
                controller on Ethernet nothing changes it. With the controller
                on Wi-Fi, ESP-NOW has to use the access point's channel, and
                the nodes find it (RB_ESPNOW_FOLLOW_CHANNEL).

        config RB_ESPNOW_FOLLOW_CHANNEL
            bool "Nodes: follow the controller when it changes channel"
            default y
            help
                When the controller stops acknowledging, the node probes the
                channels 1-13 and stays on the first one the controller
                acknowledges, then saves it in NVS for the next boot. Needs
                RB_NODE_CONTROLLER_MAC set: broadcasts are never acknowledged,
                so a node sending to broadcast stays on RB_ESPNOW_CHANNEL.
                UNVERIFIED: not yet tested with a real access point changing
                channel.

        config RB_ESPNOW_LOST_FAILURES
            int "Nodes: search after this many unacknowledged packets in a row"
            depends on RB_ESPNOW_FOLLOW_CHANNEL
            range 2 50
            default 5
            help
                ESP-NOW already retries every packet, so a few failures in a
                row mean the controller is gone from this channel. A sensor
                node sends about 3 packets a second, so 5 is under 2 seconds.

    endmenu

    menu "Sensor node (ESP32-C6)"

        config RB_NODE_ID
            int "Sensor node ID"
            range 1 65535
            default 1
            help
                Identifier this sensor node puts in every ESP-NOW packet. Each
                node needs its own ID, matching the controller's "Sensor node
                link" menu. Defaults: presence node A = 1, presence node B = 2,
                thermal node = 3 (set by each project's sdkconfig files).

        config RB_NODE_STATUS_LED_GPIO
            int "Status LED GPIO (-1 = none)"
            range -1 30
            default 15
            help
                On-board LED. DFR1117 (ESP32-C6 mini) schematic: LED1 on IO15
                through 2.7 kOhm.

        config RB_NODE_HEALTH_LOG_PERIOD_MS
            int "Board health log period (ms)"
            range 1000 600000
            default 10000
            help
                How often the node logs uptime and heap statistics. Kept slow
                so the serial monitor is not flooded.

        config RB_NODE_CONTROLLER_MAC
            string "Controller (ESP32-S3) Wi-Fi STA MAC address"
            default "FF:FF:FF:FF:FF:FF"
            help
                Where the node sends its ESP-NOW packets. Copy the MAC that
                the controller firmware (or testing/s3_board) prints at boot.
                The default is broadcast, which is fine on the bench but
                should be replaced for real use.

        config RB_NODE_DATA_PERIOD_MS
            int "Data (PRESENCE_DATA / THERMAL_DATA) transmit period (ms)"
            range 100 10000
            default 500

        config RB_NODE_HEARTBEAT_PERIOD_MS
            int "HEARTBEAT transmit period (ms)"
            range 200 60000
            default 1000

        config RB_MLX_STALE_TIMEOUT_MS
            int "Thermal reading goes invalid after (ms) without a good frame"
            range 500 60000
            default 3000

        menu "C4002 presence sensor"

            config RB_C4002_UART_PORT
                int "UART port"
                range 0 1
                default 1

            config RB_C4002_RX_GPIO
                int "ESP32 RX GPIO (wired to C4002 TX)"
                range 0 30
                default 4
                help
                    DFR1117 (ESP32-C6 mini) header P3 pin 3 (IO4). Confirmed
                    on the bench with testing/c4002. IO16/IO17 would also
                    work but are UART0, where the ROM prints at boot.

            config RB_C4002_TX_GPIO
                int "ESP32 TX GPIO (wired to C4002 RX)"
                range 0 30
                default 5
                help
                    DFR1117 (ESP32-C6 mini) header P3 pin 4 (IO5). Confirmed
                    on the bench with testing/c4002.

            config RB_C4002_OUT_GPIO
                int "C4002 OUT pin GPIO (-1 = not wired)"
                range -1 30
                default -1

            config RB_C4002_BAUD
                int "Baud rate"
                default 115200

            config RB_C4002_STALE_TIMEOUT_MS
                int "Reading goes invalid after (ms) without a report"
                range 200 60000
                default 3000
                help
                    Make this several report periods long. After it expires the
                    reading is invalid, which is not the same as "no presence".

            config RB_C4002_APPLY_SETTINGS
                bool "Push the detection settings below to the sensor at boot"
                default y

            config RB_C4002_REPORT_PERIOD_DS
                int "Report period (0.1 s units)"
                range 1 255
                default 5
                depends on RB_C4002_APPLY_SETTINGS

            config RB_C4002_RANGE_MIN_CM
                int "Detection range minimum (cm)"
                range 0 1100
                default 0
                depends on RB_C4002_APPLY_SETTINGS

            config RB_C4002_RANGE_MAX_CM
                int "Detection range maximum (cm)"
                range 0 1100
                default 1100
                depends on RB_C4002_APPLY_SETTINGS
                help
                    Shrinking this to the cooking area is one of the knobs for
                    the false static-presence investigation.

            choice RB_C4002_RESOLUTION
                prompt "Distance gate resolution"
                default RB_C4002_RESOLUTION_80CM
                depends on RB_C4002_APPLY_SETTINGS
                config RB_C4002_RESOLUTION_80CM
                    bool "80 cm (15 gates, ~11 m)"
                config RB_C4002_RESOLUTION_20CM
                    bool "20 cm (25 gates, ~4.9 m)"
            endchoice

            config RB_C4002_MOTION_SENSITIVITY
                int "Motion sensitivity group (0 low, 1 mid, 2 high)"
                range 0 2
                default 1
                depends on RB_C4002_APPLY_SETTINGS

            config RB_C4002_PRESENCE_SENSITIVITY
                int "Static presence sensitivity group (0 low, 1 mid, 2 high)"
                range 0 2
                default 1
                depends on RB_C4002_APPLY_SETTINGS
                help
                    Lower this if the sensor reports static presence when
                    nobody is there.

            config RB_C4002_DISAPPEAR_DELAY_S
                int "Target disappear delay (s)"
                range 0 65535
                default 1
                depends on RB_C4002_APPLY_SETTINGS
                help
                    How long the sensor keeps reporting a target after it has
                    gone.

            config RB_C4002_LOCK_TIME_DS
                int "Lock time after a target leaves (0.1 s units)"
                range 2 100
                default 10
                depends on RB_C4002_APPLY_SETTINGS
                help
                    When the area goes from occupied to empty, the sensor
                    ignores targets for this long (sensor default 1 s).

            config RB_C4002_REMOTE_TUNING
                bool "Accept C4002 settings and calibration from the dashboard"
                default y
                help
                    The controller relays dashboard commands over ESP-NOW
                    (docs/c4002_tuning.md). Settings received this way are
                    saved on the node and win over the menuconfig values
                    above until the dashboard sends "reset".

            config RB_C4002_LIVE_PERIOD_MS
                int "Send raw C4002 results for the dashboard's live view every (ms), 0 = off"
                range 0 10000
                default 250
                depends on RB_C4002_REMOTE_TUNING
                help
                    Each new C4002 result (target state, stationary gates,
                    distances, energies) goes to the controller as a 46-byte
                    C4002_LIVE packet, at most this often, and the controller
                    publishes it on MQTT. Results come at the sensor's report
                    period, so a value below it changes nothing.

            config RB_C4002_ENV_CALIBRATION_AT_BOOT
                bool "Run environment calibration at boot (area must be empty)"
                default n

            config RB_C4002_ENV_CALIBRATION_S
                int "Environment calibration duration (s)"
                range 1 600
                default 30
                depends on RB_C4002_ENV_CALIBRATION_AT_BOOT

        endmenu

